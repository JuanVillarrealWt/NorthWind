@page "/products"
@using System.Globalization
@using System.Text.RegularExpressions
@inject AppNotificationService Notifications
@implements IDisposable
@attribute [Authorize]
@using NorthWind.Sales.Frontend.BusinessObjects.Interfaces
@using NorthWind.Sales.Frontend.BusinessObjects.ViewModels
@inject ISearchProductsGateway SearchGateway
@inject IProductCrudGateway CrudGateway

<PageTitle>Administración de productos - NorthWind</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-success mb-1">
                <i class="bi bi-box-seam me-2"></i> Administración del catálogo de productos
            </h2>
            <p class="text-muted mb-0">Crea, actualiza, modifica precios o elimina productos del sistema.</p>
        </div>
        <button class="btn btn-success btn-lg fw-bold shadow-sm" @onclick="OpenCreateModal">
            <i class="bi bi-plus-circle-fill me-1"></i> Agregar producto
        </button>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @StatusMessage
            <button type="button" class="btn-close" @onclick="() => StatusMessage = string.Empty"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="input-group">
                <select class="form-select form-select-lg" style="max-width: 180px" @bind="FilterField" @bind:after="OnFilterFieldChanged" aria-label="Campo de búsqueda">
                    <option value="Id">ID del producto</option>
                    <option value="Name">Nombre</option>
                </select>
                <input type="text" class="form-control form-control-lg" inputmode="@(FilterField == "Id" ? "numeric" : null)"
                       maxlength="@(FilterField == "Id" ? 5 : null)" data-numeric-only="@(FilterField == "Id" ? "true" : null)" placeholder="@(FilterField == "Id" ? "Ingresa el ID numérico" : "Ingresa el nombre")"
                       value="@FilterText" @oninput="OnFilterInput" @onkeyup="OnKeyUp" />
                <button class="btn btn-outline-success fw-bold" @onclick="SearchImmediately">Buscar</button>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Cargando productos...</span>
            </div>
            <p class="mt-2 text-muted">Cargando catálogo de productos...</p>
        </div>
    }
    else if (Products == null || !Products.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox text-muted display-4 mb-3 d-block"></i>
                <h4 class="text-muted fw-bold">No se encontraron productos</h4>
                <p class="text-muted">Selecciona «Agregar producto» para registrar uno nuevo.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID del producto</th>
                                <th>Nombre del producto</th>
                                <th class="text-end">Precio unitario ($)</th>
                                <th class="text-center">Unidades disponibles</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in PagedProducts)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary font-monospace fs-6">#@p.Id</span></td>
                                    <td class="fw-bold">@p.Name</td>
                                    <td class="text-end font-monospace text-success fw-bold fs-6">@CurrencyFormatter.Format(p.UnitPrice)</td>
                                    <td class="text-center font-monospace">
                                        @if (p.UnitsInStock > 0)
                                        {
                                            <span class="badge bg-success fs-6">@p.UnitsInStock disponibles</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6">Agotado (0)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-warning btn-sm me-2 fw-bold" @onclick="() => OpenEditModal(p)">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm fw-bold d-inline-flex align-items-center justify-content-center" @onclick="() => DeleteProduct(p.Id)">
                                            <span class="delete-action-x" aria-hidden="true">×</span> Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @if (Products.Any())
        {
            <div class="d-flex justify-content-between align-items-center p-3">
                <small class="text-muted">Página @CurrentPage de @TotalPages · @Products.Count() productos</small>
                <div class="d-flex align-items-center gap-2">
                    <label for="productPageSize" class="form-label mb-0 small">Elementos por página</label>
                    <select id="productPageSize" class="form-select form-select-sm" style="width: auto" @bind="PageSize" @bind:after="OnPageSizeChanged" aria-label="Elementos por página">
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div class="btn-group">
                    <button class="btn btn-outline-success" disabled="@(CurrentPage == 1)" @onclick="() => ChangePage(-1)">Anterior</button>
                    <button class="btn btn-outline-success" disabled="@(CurrentPage >= TotalPages)" @onclick="() => ChangePage(1)">Siguiente</button>
                </div>
            </div>
        }
    }
</div>

@if (IsModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-box-seam me-2"></i> @(IsEditing ? "Editar producto" : "Crear producto")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del producto</label>
                        <input type="text" class="form-control" maxlength="40" data-trim-leading="true" value="@CurrentProduct.Name" @oninput="OnProductNameInput" placeholder="Ej.: té chai" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Precio unitario ($)</label>
                        <input type="text" inputmode="decimal" class="form-control" data-decimal-only="true" value="@ProductPriceInput" @oninput="OnProductPriceInput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Unidades disponibles</label>
                        <input type="text" inputmode="numeric" class="form-control" data-numeric-only="true" value="@ProductStockInput" @oninput="OnProductStockInput" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button type="button" class="btn btn-success fw-bold" @onclick="SaveProduct">Guardar producto</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ProductToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.55);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-exclamation-triangle text-warning display-5"></i>
                    <h5 class="fw-bold mt-3">¿Eliminar producto?</h5>
                    <p class="text-muted mb-4">¿Seguro que deseas eliminar <strong>@ProductToDelete.Name</strong>? Esta acción no se puede deshacer.</p>
                    <button class="btn btn-light me-2" @onclick="CancelDelete">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteProduct">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string FilterText = string.Empty;
    private string FilterField = "Id";
    private readonly SearchDebouncer SearchDebouncer = new();
    private int SearchRequestVersion;
    private IEnumerable<ProductItemViewModel> Products = [];
    private bool IsLoading = false;
    private bool IsModalOpen = false;
    private bool IsEditing = false;
    private ProductItemViewModel CurrentProduct = new();
    private string ProductPriceInput = "0";
    private string ProductStockInput = "10";
    private string StatusMessage = string.Empty;
    private int PageSize = 10;
    private int CurrentPage = 1;
    private ProductItemViewModel? ProductToDelete;
    private IEnumerable<ProductItemViewModel> PagedProducts => Products.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Products.Count() / (double)PageSize));

    private void ChangePage(int delta) => CurrentPage = Math.Clamp(CurrentPage + delta, 1, TotalPages);
    private void OnPageSizeChanged() => CurrentPage = 1;

    private Task OnFilterFieldChanged()
    {
        FilterText = string.Empty;
        SearchDebouncer.CancelPending();
        return LoadProducts();
    }

    private Task OnFilterInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        FilterText = FilterField == "Id"
            ? new string(value.Where(char.IsAsciiDigit).Take(10).ToArray())
            : value;
        return SearchDebouncer.RunAsync(LoadProducts);
    }

    private Task SearchImmediately()
    {
        SearchDebouncer.CancelPending();
        return LoadProducts();
    }

    public void Dispose() => SearchDebouncer.Dispose();

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            return SearchImmediately();
        }

        return Task.CompletedTask;
    }

    private async Task LoadProducts()
    {
        var requestVersion = ++SearchRequestVersion;
        IsLoading = true;
        try
        {
            var term = FilterText.Trim();
            var results = await SearchGateway.SearchProducts(term);
            if (requestVersion != SearchRequestVersion) return;

            Products = string.IsNullOrEmpty(term)
                ? results
                : FilterField == "Id"
                    ? results.Where(p => p.Id.ToString().Contains(term, StringComparison.Ordinal))
                    : results.Where(p => p.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
            CurrentPage = 1;
        }
        finally
        {
            if (requestVersion == SearchRequestVersion) IsLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        IsEditing = false;
        CurrentProduct = new ProductItemViewModel { Id = 0, Name = string.Empty, UnitPrice = 0, UnitsInStock = 10 };
        ProductPriceInput = "0";
        ProductStockInput = "10";
        IsModalOpen = true;
    }

    private void OpenEditModal(ProductItemViewModel product)
    {
        IsEditing = true;
        CurrentProduct = new ProductItemViewModel { Id = product.Id, Name = product.Name, UnitPrice = product.UnitPrice, UnitsInStock = product.UnitsInStock };
        ProductPriceInput = product.UnitPrice.ToString("0.##", CultureInfo.InvariantCulture);
        ProductStockInput = product.UnitsInStock.ToString(CultureInfo.InvariantCulture);
        IsModalOpen = true;
    }

    private void OnProductNameInput(ChangeEventArgs args) =>
        CurrentProduct.Name = TextInputNormalizer.NormalizeInitialCapital(args.Value?.ToString());

    private void OnProductPriceInput(ChangeEventArgs args) =>
        ProductPriceInput = TextInputNormalizer.NormalizeLeadingZeros(args.Value?.ToString());

    private void OnProductStockInput(ChangeEventArgs args) =>
        ProductStockInput = TextInputNormalizer.NormalizeLeadingZeros(args.Value?.ToString());

    private void CloseModal()
    {
        IsModalOpen = false;
    }

    private async Task SaveProduct()
    {
        CurrentProduct.Name = TextInputNormalizer.NormalizeInitialCapital(CurrentProduct.Name);
        if (string.IsNullOrWhiteSpace(CurrentProduct.Name))
        {
            Notifications.ShowError("Datos del producto no válidos", "El nombre del producto es obligatorio.", "Escribe un nombre antes de guardar.");
            return;
        }

        if (!Regex.IsMatch(ProductPriceInput, @"^\d+(?:\.\d{1,2})?$")
            || !decimal.TryParse(ProductPriceInput, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var unitPrice)
            || unitPrice <= 0m
            || unitPrice > 999999.99m)
        {
            Notifications.ShowError("Precio no válido", "El precio debe ser mayor que cero y solo puede usar números y un punto decimal, con máximo dos decimales.", "Ejemplo: 25.50");
            return;
        }

        if (!short.TryParse(ProductStockInput, NumberStyles.None, CultureInfo.InvariantCulture, out var unitsInStock))
        {
            Notifications.ShowError("Existencias no válidas", "Ingresa solo números enteros entre 0 y 32767.", "No uses espacios ni signos.");
            return;
        }

        CurrentProduct.UnitPrice = unitPrice;
        CurrentProduct.UnitsInStock = unitsInStock;

        try
        {
            if (IsEditing)
            {
                await CrudGateway.UpdateProduct(CurrentProduct);
                StatusMessage = $"El producto «{CurrentProduct.Name}» se actualizó correctamente.";
            }
            else
            {
                await CrudGateway.CreateProduct(CurrentProduct);
                StatusMessage = $"El producto «{CurrentProduct.Name}» se creó correctamente.";
            }
            IsModalOpen = false;
            await LoadProducts();
        }
        catch (Exception exception)
        {
            Notifications.ShowError("No se pudo guardar el producto", GetErrorMessage(exception, "Ocurrió un problema al guardar el producto."), "Verifica los datos y vuelve a intentarlo.");
        }
    }

    private void DeleteProduct(int productId) => ProductToDelete = Products.FirstOrDefault(p => p.Id == productId);

    private void CancelDelete() => ProductToDelete = null;

    private async Task ConfirmDeleteProduct()
    {
        if (ProductToDelete == null) return;
        var productId = ProductToDelete.Id;
        ProductToDelete = null;
        try
        {
            await CrudGateway.DeleteProduct(productId);
            StatusMessage = $"El producto n.º {productId} se eliminó correctamente.";
            await LoadProducts();
        }
        catch (Exception exception)
        {
            Notifications.ShowError("No se pudo eliminar el producto", GetErrorMessage(exception, "Ocurrió un problema al eliminar el producto."), "Actualiza la lista y comprueba que el producto todavía exista.");
        }
    }

    private static string GetErrorMessage(Exception exception, string fallback) =>
        exception is HttpRequestException && !string.IsNullOrWhiteSpace(exception.Message) ? exception.Message : fallback;
}
