@page "/user/login"
<ErrorBoundary @ref="ErrorBoundaryRef">
    <ChildContent>
        <UserLoginComponent ViewModel="ViewModel" />
    </ChildContent>
    <ErrorContent Context="exception">
        <ExceptionDisplay Exception="exception" />
        <button class="btn btn-outline-secondary" @onclick="Recover">Volver a intentar</button>
    </ErrorContent>
</ErrorBoundary>
