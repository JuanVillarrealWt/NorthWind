@inherits LayoutComponentBase

<NotificationHost />

<div class="page">
    <div class="sidebar">
        <NavMenu>
            <NavBarBrand><SectionOutlet SectionId="@NavBarBrandSection" /></NavBarBrand>
            <NavBarItems><SectionOutlet SectionId="@NavBarItemsSection" /></NavBarItems>
        </NavMenu>
    </div>
    <main>
        <div class="top-row px-4"><SectionOutlet SectionId="@HeaderSection" /></div>
        <article class="content px-4">
            <ErrorBoundary @ref="ErrorBoundaryRef">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="exception">
                    <ExceptionDisplay Exception="exception" />
                    <button class="btn btn-outline-secondary" @onclick="Recover">Volver a intentar</button>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    public static object NavBarBrandSection = new();
    public static object NavBarItemsSection = new();
    public static object HeaderSection = new();
    private ErrorBoundary? ErrorBoundaryRef;

    private void Recover() => ErrorBoundaryRef?.Recover();
}
