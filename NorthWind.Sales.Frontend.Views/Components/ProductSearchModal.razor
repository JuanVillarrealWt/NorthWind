@implements IDisposable
@using NorthWind.Sales.Frontend.BusinessObjects.Interfaces
@using NorthWind.Sales.Frontend.BusinessObjects.ViewModels
@inject ISearchProductsGateway Gateway

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-box-seam me-2"></i> Búsqueda Inteligente de Productos
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="input-group mb-3">
                        <select class="form-select" style="max-width: 160px" @bind="FilterField" @bind:after="OnFilterFieldChanged" aria-label="Campo de búsqueda">
                            <option value="Id">ID del producto</option>
                            <option value="Name">Nombre</option>
                        </select>
                        <input type="text" class="form-control form-control-lg" inputmode="@(FilterField == "Id" ? "numeric" : null)" maxlength="@(FilterField == "Id" ? 5 : null)" data-numeric-only="@(FilterField == "Id" ? "true" : null)"
                               placeholder="@(FilterField == "Id" ? "ID numérico" : "Nombre del producto")"
                               value="@FilterText" @oninput="OnFilterInput" @onkeyup="OnKeyUp" />
                        <button class="btn btn-success" type="button" @onclick="SearchImmediately">Buscar</button>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted">Buscando productos...</p>
                        </div>
                    }
                    else if (Products == null || !Products.Any())
                    {
                        <div class="alert alert-warning text-center my-3">
                            <i class="bi bi-exclamation-triangle me-2"></i> No se encontraron productos con ese criterio de búsqueda.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre del producto</th>
                                        <th>Precio unitario</th>
                                        <th>Stock</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in PaginatedProducts)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary font-monospace">@product.Id</span></td>
                                            <td class="fw-bold">@product.Name</td>
                                            <td class="text-success font-monospace">@CurrencyFormatter.Format(product.UnitPrice)</td>
                                            <td>
                                                @if (product.UnitsInStock > 0)
                                                {
                                                    <span class="badge bg-success">@product.UnitsInStock disponibles</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Agotado</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-primary fw-bold" @onclick="() => SelectProduct(product)">
                                                    <i class="bi bi-plus-circle me-1"></i> Seleccionar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Block Pagination -->
                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded border">
                            <small class="text-muted">
                                Mostrando @(Math.Min((CurrentPage - 1) * PageSize + 1, TotalItems)) a @(Math.Min(CurrentPage * PageSize, TotalItems)) de @TotalItems productos
                            </small>
                            <div class="d-flex align-items-center gap-2">
                                <label for="productModalPageSize" class="form-label mb-0 small">Elementos por página</label>
                                <select id="productModalPageSize" class="form-select form-select-sm" style="width: auto" @bind="PageSize" @bind:after="OnPageSizeChanged" aria-label="Elementos por página">
                                    <option value="10">10</option>
                                    <option value="15">15</option>
                                    <option value="20">20</option>
                                    <option value="30">30</option>
                                    <option value="50">50</option>
                                </select>
                                <nav aria-label="Paginación de búsqueda de productos">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="PreviousPage">Anterior</button>
                                        </li>
                                        @for (int p = 1; p <= TotalPages; p++)
                                        {
                                            var pageNumber = p;
                                            <li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                            </li>
                                        }
                                        <li class="page-item @(CurrentPage == TotalPages || TotalPages == 0 ? "disabled" : "")">
                                            <button class="page-link" @onclick="NextPage">Siguiente</button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<ProductItemViewModel> OnProductSelected { get; set; }

    private string FilterText = string.Empty;
    private string FilterField = "Id";
    private readonly SearchDebouncer SearchDebouncer = new();
    private int SearchRequestVersion;
    private IEnumerable<ProductItemViewModel> Products = [];
    private bool IsLoading = false;

    // Block Pagination state
    private int CurrentPage = 1;
    private int PageSize = 10;

    private int TotalItems => Products.Count();
    private int TotalPages => (int)Math.Ceiling((double)TotalItems / PageSize);

    private void OnPageSizeChanged() => CurrentPage = 1;

    private IEnumerable<ProductItemViewModel> PaginatedProducts =>
        Products.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private Task OnFilterFieldChanged()
    {
        FilterText = string.Empty;
        SearchDebouncer.CancelPending();
        return ExecuteSearch();
    }

    private Task OnFilterInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        FilterText = FilterField == "Id"
            ? new string(value.Where(char.IsAsciiDigit).Take(10).ToArray())
            : value;
        return SearchDebouncer.RunAsync(ExecuteSearch);
    }

    private Task SearchImmediately()
    {
        SearchDebouncer.CancelPending();
        return ExecuteSearch();
    }

    public void Dispose() => SearchDebouncer.Dispose();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && (!Products.Any() || string.IsNullOrEmpty(FilterText)))
        {
            await ExecuteSearch();
        }
    }

    private Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            return SearchImmediately();
        }

        return Task.CompletedTask;
    }

    private async Task ExecuteSearch()
    {
        var requestVersion = ++SearchRequestVersion;
        IsLoading = true;
        CurrentPage = 1;
        try
        {
            var term = FilterText.Trim();
            var results = await Gateway.SearchProducts(term);
            if (requestVersion != SearchRequestVersion) return;

            Products = string.IsNullOrEmpty(term)
                ? results
                : FilterField == "Id"
                    ? results.Where(p => p.Id.ToString().Contains(term, StringComparison.Ordinal))
                    : results.Where(p => p.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        finally
        {
            if (requestVersion == SearchRequestVersion) IsLoading = false;
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1) CurrentPage--;
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages) CurrentPage++;
    }

    private async Task SelectProduct(ProductItemViewModel product)
    {
        await OnProductSelected.InvokeAsync(product);
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
