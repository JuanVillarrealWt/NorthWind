                    <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.428L5.838 5.041l2.408.964 5.912-2.365zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1.5 1.5 0 0 1-.901 1.38l-6.5 2.6a1.5 1.5 0 0 1-1.198 0l-6.5-2.6A1.5 1.5 0 0 1 0 12.162V3.5a.5.5 0 0 1 .314-.464z"/>
