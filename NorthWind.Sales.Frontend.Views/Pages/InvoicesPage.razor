@page "/invoices"
@attribute [Authorize]
@using NorthWind.Sales.Entities.Dtos.SearchOrders
@using NorthWind.Sales.Frontend.BusinessObjects.Interfaces
@using Microsoft.JSInterop
@inject ISearchOrdersGateway OrdersGateway
@inject IJSRuntime JSRuntime


<PageTitle>Búsqueda y Visualización de Facturas - NorthWind</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-receipt-cutoff me-2"></i> Búsqueda y Visualización de Facturas
            </h2>
            <p class="text-muted mb-0">Consulta y visualiza las órdenes guardadas por Número de Orden o Cliente.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control form-control-lg"
                               placeholder="Buscar por # de Orden o ID/Nombre del Cliente..."
                               @bind="FilterText" @bind:event="oninput" @keyup="OnKeyUp" />
                    </div>
                </div>
                <div class="col-md-3 d-grid">
                    <button class="btn btn-primary btn-lg fw-bold" @onclick="ExecuteSearch">
                        <i class="bi bi-search me-1"></i> Buscar Facturas
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted fs-5">Cargando facturas guardadas...</p>
        </div>
    }
    else if (Orders == null || !Orders.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox text-muted display-4 mb-3 d-block"></i>
                <h4 class="text-muted fw-bold">No se encontraron facturas</h4>
                <p class="text-muted">Intenta realizar una nueva búsqueda o crea una orden en el Punto de Venta.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th># Orden (Factura)</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Ciudad / País</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Orders)
                            {
                                <tr>
                                    <td><span class="badge bg-primary font-monospace fs-6">#@order.Id</span></td>
                                    <td>
                                        <div class="fw-bold">@order.CustomerName</div>
                                        <small class="text-muted font-monospace">ID: @order.CustomerId</small>
                                    </td>
                                    <td>@order.OrderDate.ToString("g")</td>
                                    <td>@order.ShipCity, @order.ShipCountry</td>
                                    <td class="text-end fw-bold text-success font-monospace fs-6">@order.Total.ToString("C")</td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-primary btn-sm fw-bold" @onclick="() => ViewInvoiceDetails(order.Id)">
                                            <i class="bi bi-eye me-1"></i> Ver Factura
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (SelectedInvoice != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white p-4">
                    <div>
                        <h4 class="modal-title fw-bold mb-0">
                            <i class="bi bi-file-earmark-text me-2 text-primary"></i> FACTURA #@SelectedInvoice.Header.Id
                        </h4>
                        <small class="text-muted">NorthWind Sales Management System</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseInvoiceModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row mb-4 bg-light p-3 rounded border">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <h6 class="fw-bold text-primary border-bottom pb-1">DATOS DEL CLIENTE</h6>
                            <p class="mb-1"><strong>Cliente:</strong> @SelectedInvoice.Header.CustomerName</p>
                            <p class="mb-1"><strong>ID Cliente:</strong> <span class="badge bg-secondary">@SelectedInvoice.Header.CustomerId</span></p>
                            <p class="mb-0"><strong>Fecha de Emisión:</strong> @SelectedInvoice.Header.OrderDate.ToString("f")</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary border-bottom pb-1">DIRECCIÓN DE ENVÍO</h6>
                            <p class="mb-1"><strong>Dirección:</strong> @SelectedInvoice.Header.ShipAddress</p>
                            <p class="mb-1"><strong>Ciudad/País:</strong> @SelectedInvoice.Header.ShipCity, @SelectedInvoice.Header.ShipCountry</p>
                            <p class="mb-0"><strong>Código Postal:</strong> @SelectedInvoice.Header.ShipPostalCode</p>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-list-stars me-1"></i> DETALLE DE PRODUCTOS</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Producto</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in SelectedInvoice.Details)
                                {
                                    <tr>
                                        <td><span class="badge bg-outline-secondary font-monospace">@item.ProductId</span></td>
                                        <td class="fw-bold">@item.ProductName</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                        <td class="text-center font-monospace">@item.Quantity</td>
                                        <td class="text-end fw-bold font-monospace">@item.Subtotal.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                @{
                                    var subtotalNeto = SelectedInvoice.Details.Sum(d => d.Subtotal);
                                    var iva = subtotalNeto * 0.15m;
                                    var totalConIva = subtotalNeto + iva;
                                }
                                <tr>
                                    <td colspan="4" class="text-end fw-bold text-muted">Subtotal Neto:</td>
                                    <td class="text-end fw-bold font-monospace">@subtotalNeto.ToString("C")</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-end text-muted">IVA (15%):</td>
                                    <td class="text-end font-monospace text-muted">@iva.ToString("C")</td>
                                </tr>
                                <tr class="table-dark">
                                    <td colspan="4" class="text-end fw-bold fs-5">TOTAL CON IVA:</td>
                                    <td class="text-end fw-bold fs-5 text-success font-monospace">
                                        @totalConIva.ToString("C")
                                    </td>
                                </tr>
                            </tfoot>

                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-primary fw-bold shadow-sm" @onclick="PrintInvoice">
                        <i class="bi bi-printer-fill me-1"></i> Imprimir / Descargar PDF
                    </button>
                    <button type="button" class="btn btn-secondary fw-bold" @onclick="CloseInvoiceModal">
                        <i class="bi bi-x-lg me-1"></i> Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private string FilterText = string.Empty;
    private IEnumerable<OrderHeaderDto> Orders = [];
    private OrderInvoiceDto? SelectedInvoice = null;
    private bool IsLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await ExecuteSearch();
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearch();
        }
    }

    private async Task ExecuteSearch()
    {
        IsLoading = true;
        try
        {
            Orders = await OrdersGateway.SearchOrders(FilterText);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ViewInvoiceDetails(int orderId)
    {
        SelectedInvoice = await OrdersGateway.GetOrderById(orderId);
    }

    private void CloseInvoiceModal()
    {
        SelectedInvoice = null;
    }

    private async Task PrintInvoice()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
