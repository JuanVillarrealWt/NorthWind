@page "/customers"
@implements IDisposable
@attribute [Authorize]
@using NorthWind.Sales.Frontend.BusinessObjects.Interfaces
@using NorthWind.Sales.Frontend.BusinessObjects.ViewModels
@inject ISearchCustomersGateway SearchGateway
@inject ICustomerCrudGateway CrudGateway

<PageTitle>Administración de clientes - NorthWind</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-people-fill me-2"></i> Administración de clientes
            </h2>
            <p class="text-muted mb-0">Crea, actualiza o elimina registros de clientes.</p>
        </div>
        <button class="btn btn-primary btn-lg fw-bold shadow-sm" @onclick="OpenCreateModal">
            <i class="bi bi-person-plus-fill me-1"></i> Agregar cliente
        </button>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @StatusMessage
            <button type="button" class="btn-close" @onclick="() => StatusMessage = string.Empty"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="input-group">
                <select class="form-select form-select-lg" style="max-width: 190px" @bind="FilterField" @bind:after="OnFilterFieldChanged" aria-label="Campo de búsqueda">
                    <option value="Id">ID del cliente</option>
                    <option value="Name">Nombre</option>
                </select>
                <input type="text" class="form-control form-control-lg" maxlength="@(FilterField == "Id" ? 5 : null)"
                       placeholder="@(FilterField == "Id" ? "Ingresa el código de cliente" : "Ingresa el nombre")"
                       value="@FilterText" @oninput="OnFilterInput" @onkeyup="OnKeyUp" />
                <button class="btn btn-outline-primary fw-bold" @onclick="SearchImmediately">Buscar</button>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando clientes...</span>
            </div>
            <p class="mt-2 text-muted">Cargando directorio de clientes...</p>
        </div>
    }
    else if (Customers == null || !Customers.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <i class="bi bi-people text-muted display-4 mb-3 d-block"></i>
                <h4 class="text-muted fw-bold">No se encontraron clientes</h4>
                <p class="text-muted">Selecciona «Agregar cliente» para registrar uno nuevo.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID del cliente</th>
                                <th>Empresa / nombre completo</th>
                                <th class="text-end">Saldo actual</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in PagedCustomers)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary font-monospace fs-6">@c.Id</span></td>
                                    <td class="fw-bold">@c.Name</td>
                                    <td class="text-end font-monospace text-dark fs-6">@CurrencyFormatter.Format(c.CurrentBalance)</td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-warning btn-sm me-2 fw-bold" @onclick="() => OpenEditModal(c)">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm fw-bold" @onclick="() => DeleteCustomer(c.Id)">
                                            <i class="bi bi-trash-fill me-1"></i> Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @if (Customers.Any())
        {
            <div class="d-flex justify-content-between align-items-center p-3">
                <small class="text-muted">Página @CurrentPage de @TotalPages · @Customers.Count() clientes</small>
                <div class="d-flex align-items-center gap-2">
                    <label for="customerPageSize" class="form-label mb-0 small">Elementos por página</label>
                    <select id="customerPageSize" class="form-select form-select-sm" style="width: auto" @bind="PageSize" @bind:after="OnPageSizeChanged" aria-label="Elementos por página">
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div class="btn-group">
                    <button class="btn btn-outline-primary" disabled="@(CurrentPage == 1)" @onclick="() => ChangePage(-1)">Anterior</button>
                    <button class="btn btn-outline-primary" disabled="@(CurrentPage >= TotalPages)" @onclick="() => ChangePage(1)">Siguiente</button>
                </div>
            </div>
        }
    }
</div>

@if (IsModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-person-fill me-2"></i> @(IsEditing ? "Editar cliente" : "Crear cliente")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">ID del cliente (código de 5 caracteres)</label>
                        <input type="text" class="form-control" maxlength="5" @bind="CurrentCustomer.Id" disabled="@IsEditing" placeholder="Ej.: ALFKI" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del cliente o empresa</label>
                        <input type="text" class="form-control" @bind="CurrentCustomer.Name" placeholder="Ej.: Alfreds Futterkiste" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Saldo actual ($)</label>
                        <input type="number" step="0.01" class="form-control" @bind="CurrentCustomer.CurrentBalance" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="SaveCustomer">Guardar cliente</button>
                </div>
            </div>
        </div>
    </div>
}

@if (CustomerToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.55);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-exclamation-triangle text-warning display-5"></i>
                    <h5 class="fw-bold mt-3">¿Eliminar cliente?</h5>
                    <p class="text-muted mb-4">¿Seguro que deseas eliminar a <strong>@CustomerToDelete.Name</strong>? Esta acción no se puede deshacer.</p>
                    <button class="btn btn-light me-2" @onclick="CancelDelete">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteCustomer">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string FilterText = string.Empty;
    private string FilterField = "Id";
    private readonly SearchDebouncer SearchDebouncer = new();
    private int SearchRequestVersion;
    private IEnumerable<CustomerItemViewModel> Customers = [];
    private bool IsLoading = false;
    private bool IsModalOpen = false;
    private bool IsEditing = false;
    private CustomerItemViewModel CurrentCustomer = new();
    private string StatusMessage = string.Empty;
    private int PageSize = 10;
    private int CurrentPage = 1;
    private CustomerItemViewModel? CustomerToDelete;
    private IEnumerable<CustomerItemViewModel> PagedCustomers => Customers.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Customers.Count() / (double)PageSize));

    private void ChangePage(int delta) => CurrentPage = Math.Clamp(CurrentPage + delta, 1, TotalPages);
    private void OnPageSizeChanged() => CurrentPage = 1;

    private Task OnFilterFieldChanged()
    {
        FilterText = string.Empty;
        SearchDebouncer.CancelPending();
        return LoadCustomers();
    }

    private Task OnFilterInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        FilterText = FilterField == "Id"
            ? new string(value.Where(char.IsAsciiLetterOrDigit).Take(5).ToArray()).ToUpperInvariant()
            : value;
        return SearchDebouncer.RunAsync(LoadCustomers);
    }

    private Task SearchImmediately()
    {
        SearchDebouncer.CancelPending();
        return LoadCustomers();
    }

    public void Dispose() => SearchDebouncer.Dispose();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            return SearchImmediately();
        }

        return Task.CompletedTask;
    }

    private async Task LoadCustomers()
    {
        var requestVersion = ++SearchRequestVersion;
        IsLoading = true;
        try
        {
            var term = FilterText.Trim();
            var results = await SearchGateway.SearchCustomers(term);
            if (requestVersion != SearchRequestVersion) return;

            Customers = string.IsNullOrEmpty(term)
                ? results
                : FilterField == "Id"
                    ? results.Where(c => c.Id.Contains(term, StringComparison.OrdinalIgnoreCase))
                    : results.Where(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
            CurrentPage = 1;
        }
        finally
        {
            if (requestVersion == SearchRequestVersion) IsLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        IsEditing = false;
        CurrentCustomer = new CustomerItemViewModel { Id = string.Empty, Name = string.Empty, CurrentBalance = 0 };
        IsModalOpen = true;
    }

    private void OpenEditModal(CustomerItemViewModel customer)
    {
        IsEditing = true;
        CurrentCustomer = new CustomerItemViewModel { Id = customer.Id, Name = customer.Name, CurrentBalance = customer.CurrentBalance };
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
    }

    private async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(CurrentCustomer.Id) || string.IsNullOrWhiteSpace(CurrentCustomer.Name))
        {
            StatusMessage = "Ingresa un ID de cliente y un nombre válidos.";
            return;
        }

        try
        {
            if (IsEditing)
            {
                await CrudGateway.UpdateCustomer(CurrentCustomer);
                StatusMessage = $"El cliente «{CurrentCustomer.Name}» se actualizó correctamente.";
            }
            else
            {
                await CrudGateway.CreateCustomer(CurrentCustomer);
                StatusMessage = $"El cliente «{CurrentCustomer.Name}» se creó correctamente.";
            }
            IsModalOpen = false;
            await LoadCustomers();
        }
        catch (Exception)
        {
            StatusMessage = "No se pudo guardar el cliente. Inténtalo de nuevo.";
        }
    }

    private void DeleteCustomer(string customerId) => CustomerToDelete = Customers.FirstOrDefault(c => c.Id == customerId);

    private void CancelDelete() => CustomerToDelete = null;

    private async Task ConfirmDeleteCustomer()
    {
        if (CustomerToDelete == null) return;
        var customerId = CustomerToDelete.Id;
        CustomerToDelete = null;
        try
        {
            await CrudGateway.DeleteCustomer(customerId);
            StatusMessage = $"El cliente «{customerId}» se eliminó correctamente.";
            await LoadCustomers();
        }
        catch (Exception)
        {
            StatusMessage = "No se pudo eliminar el cliente. Inténtalo de nuevo.";
        }
    }
}
