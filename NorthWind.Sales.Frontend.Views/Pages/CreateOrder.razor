@page "/createorder"
@attribute [Authorize]

<PageTitle>@CreateOrderMessages.CreateOrderPageTitle</PageTitle>
<ErrorBoundary @ref="ErrorBoundaryRef">
    <ChildContent>
        <CreateOrderComponent Order="ViewModel" />
    </ChildContent>
    <ErrorContent Context="exception">
        <ExceptionDisplay Exception="exception" />
        <button class="btn btn-danger" @onclick="Recover">@CommonMessages.OK</button>
    </ErrorContent>
</ErrorBoundary>
